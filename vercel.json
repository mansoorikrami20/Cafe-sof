{
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": null,
  "rewrites": [{"source":"/admin","destination":"/admin/index.html"},{"source":"/admin/","destination":"/admin/index.html"}],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"same-origin"}]},
    {"source":"/admin/(.*)","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"Content-Security-Policy","value":"default-src 'self'; img-src 'self' blob:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}]}
  ]
}
